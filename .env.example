# LeaseLens environment template — copy to `.env` and fill in YOUR OWN keys.
# Placeholder values only. Never commit a filled-in .env.
# Used by docker-compose.yml (backend/config.py defines these settings;
# the same keys also work in backend/.env for local non-Docker runs).

# --- Meta Model API (SAM 3.1 segmentation + Muse Voice transcription) ---
META_API_KEY=your-meta-api-key-here
META_API_BASE_URL=https://api.meta.ai/v1
META_CHAT_MODEL_ID=

# --- Baseten (chat / contract reasoning, model: muse-spark-open-1026) ---
BASETEN_API_KEY=your-baseten-api-key-here
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL_ID=meta-models/muse-spark-open-1026

# Chat provider: baseten | meta | mock (mock = no live calls, cached demo data)
CHAT_PROVIDER=baseten

# --- CreditShield spend guards (internal estimates, USD) ---
ENABLE_DISK_CACHE=true
MAX_SESSION_SPEND_USD=5.00
MAX_CUMULATIVE_SPEND_USD=135.00
DEMO_OFFLINE_LOCK=false

# --- Public deployment ---
# Max live (uncached) uploads per IP per hour; cached sample assets are unlimited.
PUBLIC_RATE_LIMIT_PER_HOUR=15

# --- Ports / frontend wiring (docker-compose.yml) ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
